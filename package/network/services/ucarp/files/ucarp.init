#!/bin/sh /etc/rc.common
#
# UCARP Virtual IP manager using procd
#
# Compatible OpenWrt 23.05
#

USE_PROCD=1
START=99
STOP=10

# Path to configuration file
CONF=/etc/ucarp.conf

# Explicit paths to required binaries
IP=/sbin/ip
ARPING=/usr/bin/arping
UCARP=/usr/sbin/ucarp

start_service() {
    # Check config file exists
    [ -f "$CONF" ] || {
        echo "ucarp: configuration file $CONF not found"
        return 1
    }

    # Load configuration
    . "$CONF"

    # Validate mandatory parameters
    [ -n "$IF" ] || { echo "ucarp: IF not set"; return 1; }
    [ -n "$VIP" ] || { echo "ucarp: VIP not set"; return 1; }
    [ -n "$VMASK" ] || { echo "ucarp: VMASK not set"; return 1; }
    [ -n "$PASSWORD" ] || { echo "ucarp: PASSWORD not set"; return 1; }

    # Determine Linux interface device name via ubus
    IFACE=$(ubus call network.interface."$IF" status 2>/dev/null | jsonfilter -e '@.device')
    [ -n "$IFACE" ] || {
        echo "ucarp: cannot determine Linux device for interface $IF"
        return 1
    }

    # Determine source IP: use MYIP from config, otherwise detect via ubus
    if [ -z "$MYIP" ]; then
        MYIP=$(ubus call network.interface."$IF" status 2>/dev/null \
            | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        [ -n "$MYIP" ] || {
            echo "ucarp: unable to determine IP address for interface $IF"
            return 1
        }
        echo "Detected MYIP=$MYIP on interface $IF"
    else
        echo "Using configured MYIP=$MYIP"
    fi

    # Start UCARP under procd supervision
    procd_open_instance
    procd_set_param command $UCARP \
        --interface=$IFACE \
        --srcip=$MYIP \
        --vhid=1 \
        --pass=$PASSWORD \
        --addr=$VIP \
        $OPTIONS \
        --upscript=/usr/share/ucarp/vip-up.sh \
        --downscript=/usr/share/ucarp/vip-down.sh
    procd_set_param respawn 3600 5 5
    procd_close_instance

    echo "UCARP started: VIP $VIP on interface $IFACE (MYIP=$MYIP)"
}

stop_service() {
    # procd handles termination
    # Clean up runtime scripts
    rm -rf /var/run/ucarp
    echo "UCARP stopped"
}

